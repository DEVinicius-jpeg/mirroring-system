# Copie este arquivo para ".env" e preencha. O ".env" nunca vai para o Git.

# Senha única de acesso ao painel (obrigatória).
PAINEL_SENHA=

# Segredo dos cookies de login. Opcional: se ficar vazio, um novo é gerado a
# cada reinício (e todos precisam entrar de novo).
SEGREDO_SESSAO=

# Fuso horário usado nos registros.
TZ=America/Sao_Paulo

# Ajustes opcionais (valores padrão entre parênteses):
# ESPERA_MAX_SEG=180          tempo máximo em tela de espera antes de encerrar
# DETECCAO_INTERVALO_SEG=90   intervalo da detecção automática
# VIDEO_BITRATE_K=2500        taxa de vídeo enviada à Shopee, em kbit/s
