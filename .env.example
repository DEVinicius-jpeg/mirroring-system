# Copie este arquivo para ".env" e preencha. O ".env" nunca vai para o Git.

# Senha única de acesso ao painel (obrigatória).
PAINEL_SENHA=

# Segredo dos cookies de login. Opcional: se ficar vazio, um novo é gerado a
# cada reinício (e todos precisam entrar de novo).
SEGREDO_SESSAO=

# Cookie de uma conta SECUNDÁRIA logada no TikTok. Opcional: só é preciso para
# lives que pedem login (ex.: restrição de idade). Pode ser só o valor do
# "sessionid" ou a linha inteira de cookies. Trate como senha. Veja o README.
TIKTOK_COOKIE=

# Aviso por WhatsApp (Evolution API) quando a retransmissão para sozinha:
# live do criador terminou, Shopee recusou o envio ou erro interno.
# Opcional: com algum destes vazio, nenhum aviso é enviado.
# Evolution no mesmo PC (Docker Desktop): http://host.docker.internal:8080
WHATSAPP_API_URL=
WHATSAPP_INSTANCIA=
# Token da instância (ou a chave global da Evolution). Trate como senha.
WHATSAPP_API_KEY=
# Número que recebe os avisos, com DDI e DDD. Ex.: 5521999999999
WHATSAPP_NUMERO=

# Fuso horário usado nos registros.
TZ=America/Sao_Paulo

# Ajustes opcionais (valores padrão entre parênteses):
# ESPERA_MAX_SEG=180          tempo máximo em tela de espera antes de encerrar
# DETECCAO_INTERVALO_SEG=90   intervalo da detecção automática
# VIDEO_BITRATE_K=2500        taxa de vídeo enviada à Shopee, em kbit/s
